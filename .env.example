# Copy to .env for local runs; on Railway set these under your service → Variables.
# Generate SESSION_SECRET / ENCRYPTION_KEY / ADMIN_PASSWORD with:  npm run gen:secrets

DATABASE_URL=${{Postgres.DATABASE_URL}}   # Railway reference to the Postgres plugin
APP_URL=https://your-app.up.railway.app    # public URL, no trailing slash
ADMIN_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# Lusha (Settings → API in Lusha)
LUSHA_API_KEY=

# Microsoft 365 / Outlook (Microsoft Entra app registration, see README)
MS_TENANT_ID=organizations                 # or your tenant ID to restrict sign-in to your company
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Safety switch: true = compose and log emails but never send. Set to false to go live.
DRY_RUN=true

# Optional
TZ_BUSINESS=America/New_York
ANTHROPIC_API_KEY=                         # AI check for unclear employers and replies
SCHEDULER=on
